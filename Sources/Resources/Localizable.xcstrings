    "One line of lyrics on a quiet background. Without synchronized lyrics, the title and artist appear instead. Artwork, the equalizer and effects are disabled here; other templates keep their settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One line of lyrics on a quiet background. Without synchronized lyrics, the title and artist appear instead. Artwork, the equalizer and effects are disabled here; other templates keep their settings."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одна строка песни на спокойном фоне. Без синхронизации — название и исполнитель. Обложка, эквалайзер и эффекты здесь отключены; настройки других шаблонов сохранены."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Один рядок пісні на спокійному тлі. Без синхронізації — назва й виконавець. Обкладинку, еквалайзер та ефекти тут вимкнено; параметри інших шаблонів збережено."
          }
        }
      }
    },
